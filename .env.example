# ============================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Supabase (Dashboard → Project Settings → API) --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS. Never expose to the browser / never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (https://aistudio.google.com/apikey — free, no card) -----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- Tool: send_summary target (Slack or Discord incoming webhook URL) ------
# Server-only secret. Create at: Slack → Incoming Webhooks, or Discord →
# Channel → Integrations → Webhooks.
SUMMARY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Retrieval tuning -----------------------------------------------------------
RAG_MATCH_COUNT=6
RAG_MIN_SIMILARITY=0.35
